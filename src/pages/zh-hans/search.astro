---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="搜索"
  description="搜索蒙太奇字幕社区的内容"
  lang="zh-hans"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">

    <div class="max-w-2xl mx-auto">
      <div class="mb-10">
        <p class="text-yellow-400 text-sm font-medium mb-3">搜索</p>
        <h1 class="text-4xl font-bold text-white mb-4">搜索内容</h1>
        <p class="text-gray-400">搜索博客文章、教程、工具和项目信息。</p>
      </div>

      <div id="search" class="pagefind-ui-wrapper"></div>

      <p class="mt-6 text-gray-600 text-xs text-center">
        搜索范围涵盖博客文章、教程、工具与项目页。
      </p>
    </div>

  </div>
</BaseLayout>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script src="/pagefind/pagefind-ui.js" is:inline></script>
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof PagefindUI !== 'undefined') {
      new PagefindUI({
        element: '#search',
        showSubResults: true,
        translations: {
          placeholder: '输入关键词…',
          zero_results: '未找到结果',
        },
      });
    }
  });
</script>
