---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="搜索"
  description="搜索蒙太奇字幕社区的内容"
  lang="zh-hans"
>
  <section class="relative pt-24 md:pt-32 pb-16 border-b border-bone/[0.08]">
    <div class="absolute inset-0 bg-grid opacity-50 pointer-events-none"></div>
    <div class="relative max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <h1 class="font-display text-display text-bone leading-[0.92] tracking-tightest reveal">
        搜索<span class="font-display-italic text-signal-yellow">内容</span>
      </h1>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-3xl mx-auto px-5 sm:px-8 lg:px-12">
      <div id="search" class="pagefind-ui-wrapper"></div>
      <p class="mt-8 font-mono text-[11px] text-bone-mute tracking-[0.18em] uppercase text-center">
        — 范围：博客 · 教程 · 工具 · 项目页 —
      </p>
    </div>
  </section>
</BaseLayout>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script src="/pagefind/pagefind-ui.js" is:inline></script>

<style is:global>
  /* Pagefind UI — re-skinned to MontageSubs tokens */
  .pagefind-ui-wrapper {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: #f5f1e8;
    --pagefind-ui-text: #cfc9bb;
    --pagefind-ui-background: transparent;
    --pagefind-ui-border: rgba(245, 241, 232, 0.12);
    --pagefind-ui-tag: #1a1a1a;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0;
    --pagefind-ui-image-border-radius: 0;
    --pagefind-ui-font: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans SC', 'PingFang SC', sans-serif;
  }

  /* Search input: brand-aligned, no rounded corners */
  .pagefind-ui-wrapper .pagefind-ui__search-input {
    background: rgba(245, 241, 232, 0.03);
    border: 1px solid rgba(245, 241, 232, 0.12);
    color: var(--pagefind-ui-primary);
    border-radius: 0;
    padding: 1rem 1.25rem;
    font-size: 1rem;
    transition: border-color 0.2s, background 0.2s;
  }
  .pagefind-ui-wrapper .pagefind-ui__search-input::placeholder {
    color: rgba(245, 241, 232, 0.35);
  }
  .pagefind-ui-wrapper .pagefind-ui__search-input:focus {
    outline: none;
    border-color: #FBC100;
    background: rgba(251, 193, 0, 0.04);
  }
  .pagefind-ui-wrapper .pagefind-ui__search-clear {
    color: var(--pagefind-ui-text);
  }

  /* Result block */
  .pagefind-ui-wrapper .pagefind-ui__result {
    border-bottom: 1px solid rgba(245, 241, 232, 0.08);
    padding: 1.5rem 0;
  }
  .pagefind-ui-wrapper .pagefind-ui__result-link {
    color: var(--pagefind-ui-primary);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s;
  }
  .pagefind-ui-wrapper .pagefind-ui__result-link:hover {
    color: #FBC100;
  }
  .pagefind-ui-wrapper .pagefind-ui__result-excerpt {
    color: var(--pagefind-ui-text);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .pagefind-ui-wrapper .pagefind-ui__result-excerpt mark {
    background: rgba(251, 193, 0, 0.18);
    color: #FBC100;
    padding: 0 0.15em;
  }

  /* Counter / message strip */
  .pagefind-ui-wrapper .pagefind-ui__message {
    color: var(--pagefind-ui-text);
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 1rem 0;
    border-bottom: 1px solid rgba(245, 241, 232, 0.08);
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof PagefindUI !== 'undefined') {
      new PagefindUI({
        element: '#search',
        showSubResults: true,
        translations: { placeholder: '输入关键词…', zero_results: '未找到结果' },
      });
    }
  });
</script>
