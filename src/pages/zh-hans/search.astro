---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="搜索"
  description="搜索蒙太奇字幕社区的内容"
  lang="zh-hans"
>
  <section class="relative pt-24 md:pt-32 pb-16 border-b border-bone/[0.08]">
    <div class="absolute inset-0 bg-grid opacity-50 pointer-events-none"></div>
    <div class="relative max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <p class="font-mono text-[11px] text-signal-yellow tracking-[0.22em] uppercase mb-6 reveal">搜索 / Search</p>
      <h1 class="font-display text-display text-bone leading-[0.92] tracking-tightest reveal">
        搜索<span class="font-display-italic text-signal-yellow">内容</span>
      </h1>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-3xl mx-auto px-5 sm:px-8 lg:px-12">
      <div id="search" class="pagefind-ui-wrapper"></div>
      <p class="mt-8 font-mono text-[11px] text-bone-mute tracking-[0.18em] uppercase text-center">
        — 范围：博客 · 教程 · 工具 · 项目页 —
      </p>
    </div>
  </section>
</BaseLayout>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script src="/pagefind/pagefind-ui.js" is:inline></script>
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof PagefindUI !== 'undefined') {
      new PagefindUI({
        element: '#search',
        showSubResults: true,
        translations: { placeholder: '输入关键词…', zero_results: '未找到结果' },
      });
    }
  });
</script>
