---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui } from '../../i18n';

const lang = 'zh-hans';
const t = (k: keyof typeof ui['zh-hans']) => ui['zh-hans'][k];

const tracks = [
  {
    id: 'translate', num: '01',
    title: t('contribute.translator.title'),
    body: t('contribute.translator.body'),
    skillsTitle: t('contribute.translator.skills_title'),
    skills: [t('contribute.translator.s1'), t('contribute.translator.s2'), t('contribute.translator.s3'), t('contribute.translator.s4')],
    cta: t('contribute.translator.cta'), href: 'https://t.me/MontageSubs',
  },
  {
    id: 'develop', num: '02',
    title: t('contribute.dev.title'),
    body: t('contribute.dev.body'),
    skillsTitle: t('contribute.dev.skills_title'),
    skills: [t('contribute.dev.s1'), t('contribute.dev.s2'), t('contribute.dev.s3'), t('contribute.dev.s4')],
    cta: t('contribute.dev.cta'), href: 'https://github.com/MontageSubs',
  },
  {
    id: 'docs', num: '03',
    title: t('contribute.docs.title'),
    body: t('contribute.docs.body'),
    skillsTitle: t('contribute.docs.skills_title'),
    skills: [t('contribute.docs.s1'), t('contribute.docs.s2'), t('contribute.docs.s3'), t('contribute.docs.s4')],
    cta: t('contribute.docs.cta'), href: 'mailto:docs@montagesubs.org',
  },
];

const supportOptions = [
  { label: t('contribute.support.code'),     n: '01' },
  { label: t('contribute.support.docs'),     n: '02' },
  { label: t('contribute.support.share'),    n: '03' },
  { label: t('contribute.support.feedback'), n: '04' },
];
---

<BaseLayout title="参与我们" description="无论你是译者、开发者还是观众，都能在蒙太奇字幕社区找到自己的位置。" lang={lang}>

  <section class="relative pt-24 md:pt-32 pb-16 border-b border-bone/[0.08]">
    <div class="absolute inset-0 bg-grid opacity-50 pointer-events-none"></div>
    <div class="relative max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <p class="font-mono text-[11px] text-signal-yellow tracking-[0.22em] uppercase mb-6 reveal">{t('contribute.kicker')}</p>
      <div class="grid lg:grid-cols-12 gap-10">
        <h1 class="lg:col-span-7 font-display text-display text-bone leading-[0.92] tracking-tightest reveal">
          参与<span class="font-display-italic text-signal-yellow">我们</span>
        </h1>
        <p class="lg:col-span-5 self-end text-bone-dim text-lg leading-relaxed reveal">{t('contribute.lead')}</p>
      </div>
    </div>
  </section>

  <!-- Tracks -->
  <section class="py-24 border-b border-bone/[0.08]">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <div class="grid md:grid-cols-3 gap-px bg-bone/[0.08] border border-bone/[0.08] reveal-up-stagger">
        {tracks.map((tr) => (
          <article id={tr.id} class="group bg-ink p-8 md:p-10 flex flex-col">
            <p class="font-mono text-[11px] text-signal-yellow tracking-[0.22em]">{tr.num}</p>
            <h2 class="mt-4 font-display text-3xl text-bone group-hover:text-signal-yellow transition-colors leading-tight">{tr.title}</h2>
            <p class="mt-4 text-bone-dim text-sm leading-relaxed">{tr.body}</p>

            <p class="mt-8 font-mono text-[11px] text-bone-mute uppercase tracking-[0.18em]">— {tr.skillsTitle}</p>
            <ul class="mt-4 space-y-2 flex-1">
              {tr.skills.map(s => (
                <li class="flex gap-3 text-bone-dim text-sm">
                  <span class="font-mono text-signal-yellow text-[11px] mt-1">●</span>
                  <span>{s}</span>
                </li>
              ))}
            </ul>

            <a href={tr.href} target={tr.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer"
              class="mt-8 inline-flex items-center gap-2 text-signal-yellow text-sm border-b border-signal-yellow/40 hover:border-signal-yellow pb-1 self-start">
              {tr.cta} →
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Support -->
  <section id="support" class="py-24">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <div class="grid lg:grid-cols-12 gap-10">
        <div class="lg:col-span-5 reveal">
          <p class="font-mono text-[11px] text-bone-mute uppercase tracking-[0.2em] mb-6">— {t('contribute.support.title')}</p>
          <h2 class="font-display text-mega text-bone leading-[0.95] mb-6">支持<span class="font-display-italic text-signal-yellow">我们</span></h2>
          <p class="text-bone-dim leading-relaxed">{t('contribute.support.body')}</p>
        </div>
        <div class="lg:col-span-7 reveal">
          <p class="font-mono text-[11px] text-bone-mute uppercase tracking-[0.2em] mb-6">— {t('contribute.support.options_title')}</p>
          <ol class="grid grid-cols-2 gap-px bg-bone/[0.08] border border-bone/[0.08]">
            {supportOptions.map((s) => (
              <li class="bg-ink p-6 md:p-8 hover:bg-ink-800 transition-colors group">
                <div class="flex items-baseline gap-3">
                  <span class="font-mono text-[11px] text-bone-mute tracking-[0.2em]">{s.n}</span>
                </div>
                <p class="mt-4 font-display text-2xl text-bone group-hover:text-signal-yellow transition-colors">{s.label}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
