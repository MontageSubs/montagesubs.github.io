---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { ui } from '../../i18n';

const lang = 'zh-hans';
const t = (k: keyof typeof ui['zh-hans']) => ui['zh-hans'][k];

const values = [
  { num: '01', title: t('about.values.open.title'),        body: t('about.values.open.body') },
  { num: '02', title: t('about.values.transparent.title'), body: t('about.values.transparent.body') },
  { num: '03', title: t('about.values.collab.title'),      body: t('about.values.collab.body') },
  { num: '04', title: t('about.values.quality.title'),     body: t('about.values.quality.body') },
];

const governance = [
  { id: 'governance', title: t('about.governance.nonprofit.title'), body: t('about.governance.nonprofit.body') },
  { id: 'license',    title: t('about.governance.license.title'),   body: t('about.governance.license.body') },
  { id: 'copyright',  title: t('about.governance.copyright.title'), body: t('about.governance.copyright.body') },
  { id: 'dmca',       title: t('about.governance.dmca.title'),      body: t('about.governance.dmca.body') },
];

const contacts = [
  { label: t('about.contact.media.label'),     email: 'press@montagesubs.org' },
  { label: t('about.contact.copyright.label'), email: 'copyright@montagesubs.org' },
  { label: t('about.contact.tech.label'),      email: 'dev@montagesubs.org' },
];
---

<BaseLayout title="关于我们" description="蒙太奇字幕社区是一个非营利性开源社区，致力于推动影视内容的本地化与民主化创作。" lang={lang}>

  <!-- Page intro -->
  <section class="relative pt-24 md:pt-32 pb-16 border-b border-bone/[0.08]">
    <div class="absolute inset-0 bg-grid opacity-50 pointer-events-none"></div>
    <div class="relative max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <div class="grid lg:grid-cols-12 gap-10">
        <h1 class="lg:col-span-6 font-display text-display text-bone leading-[0.92] tracking-tightest reveal">
          {t('about.title').slice(0,2)}<span class="font-display-italic text-signal-yellow">{t('about.title').slice(2)}</span>
        </h1>
        <p class="lg:col-span-6 self-end text-bone-dim text-lg leading-relaxed max-w-xl reveal">{t('about.lead')}</p>
      </div>
    </div>
  </section>

  <!-- Mission + Values -->
  <section class="py-24 md:py-32 border-b border-bone/[0.08]">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12 grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-5 reveal">
        <p class="font-mono text-[11px] text-bone-mute tracking-[0.2em] uppercase mb-6">— {t('about.mission.title')}</p>
        <h2 class="font-display text-mega text-bone leading-[0.95] mb-8">使命与<span class="font-display-italic text-signal-yellow">愿景</span></h2>
        <p class="text-bone-dim leading-relaxed text-base">{t('about.mission.body')}</p>
      </div>
      <div class="lg:col-span-7 grid sm:grid-cols-2 gap-px bg-bone/[0.08] border border-bone/[0.08] reveal-up-stagger">
        {values.map((v) => (
          <div class="bg-ink p-8">
            <p class="font-mono text-[11px] text-signal-yellow tracking-[0.2em]">{v.num}</p>
            <h3 class="mt-4 font-display text-3xl text-bone">{v.title}</h3>
            <p class="mt-4 text-bone-dim text-sm leading-relaxed">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Governance -->
  <section id="governance" class="py-24 md:py-32 border-b border-bone/[0.08]">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <SectionHeader num="" kicker={t('about.governance.title')} title="透明度与" serifAccent="治理" />
      <div class="mt-16 grid md:grid-cols-2 gap-px bg-bone/[0.08] border border-bone/[0.08] reveal-up-stagger">
        {governance.map((g, i) => (
          <article id={g.id} class="bg-ink p-8 md:p-10">
            <div class="flex items-baseline gap-3 mb-5">
              <span class="font-mono text-[11px] text-signal-yellow tracking-[0.2em]">0{i+1}</span>
              <h3 class="font-display text-3xl text-bone">{g.title}</h3>
            </div>
            <p class="text-bone-dim text-sm leading-relaxed">{g.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Brand -->
  <section class="py-24 md:py-32 border-b border-bone/[0.08]">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12 grid lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-5 reveal">
        <p class="font-mono text-[11px] text-bone-mute tracking-[0.2em] uppercase mb-6">— {t('about.brand.title')}</p>
        <h2 class="font-display text-mega text-bone leading-[0.95] mb-6">品牌<span class="font-display-italic text-signal-yellow">资产</span></h2>
        <p class="text-bone-dim leading-relaxed mb-6">{t('about.brand.body')}</p>
        <ul class="space-y-3 text-sm">
          <li class="flex gap-3"><span class="font-mono text-signal-yellow text-[11px] mt-1">●</span><span class="text-bone-dim">{t('about.brand.color')}</span></li>
          <li class="flex gap-3"><span class="font-mono text-signal-yellow text-[11px] mt-1">●</span><span class="text-bone-dim">{t('about.brand.logo')}</span></li>
        </ul>
      </div>
      <div class="lg:col-span-7 reveal">
        <div class="aspect-[16/10] bg-ink-800 border border-bone/[0.08] flex items-center justify-center relative overflow-hidden">
          <div class="absolute inset-0 bg-grid-fine opacity-40"></div>
          <div class="relative w-32 h-32 bg-signal-yellow flex items-center justify-center">
            <span class="font-display-italic text-7xl text-ink leading-none">M</span>
          </div>
          <span class="absolute bottom-3 left-3 font-mono text-[10px] text-bone-mute uppercase tracking-[0.2em]">Logo · MontageSubs</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="py-24 md:py-32">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <SectionHeader num="" kicker={t('about.contact.title')} title="联系" serifAccent="我们" />
      <div class="mt-16 grid md:grid-cols-3 gap-px bg-bone/[0.08] border border-bone/[0.08] reveal-up-stagger">
        {contacts.map((c) => (
          <a href={`mailto:${c.email}`} class="group bg-ink p-8 hover:bg-ink-800 transition-colors">
            <p class="font-mono text-[11px] text-bone-mute tracking-[0.2em] uppercase">— {c.label}</p>
            <p class="mt-6 font-display text-2xl text-bone group-hover:text-signal-yellow transition-colors">{c.email}</p>
            <p class="mt-4 font-mono text-[11px] text-bone-mute">→ {c.label}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
