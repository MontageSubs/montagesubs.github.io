---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { ui } from '../../i18n';

const lang = 'zh-hans';
const t = (k: keyof typeof ui['zh-hans']) => ui['zh-hans'][k];

const focusItems = [
  { num: '01', label: t('home.focus.tools.label'),     title: t('home.focus.tools.title'),     desc: t('home.focus.tools.desc'),     href: `/${lang}/tools`,     cta: '查看工具库' },
  { num: '02', label: t('home.focus.research.label'),  title: t('home.focus.research.title'),  desc: t('home.focus.research.desc'),  href: `/${lang}/learn`,     cta: '阅读文章' },
  { num: '03', label: t('home.focus.community.label'), title: t('home.focus.community.title'), desc: t('home.focus.community.desc'), href: `/${lang}/community`, cta: '认识成员' },
];

const langPairs = ['EN → 中文', '日本語 → 中文', '한국어 → 中文', 'Français → 中文', 'Deutsch → 中文', 'Español → 中文', 'Italiano → 中文', 'Русский → 中文', 'Polski → 中文', 'Svenska → 中文'];
---

<BaseLayout title="蒙太奇字幕社区" description="蒙太奇字幕社区 — 连接观众、译者、开发者与影视工作者，共同构建开放、透明的字幕生态。" lang={lang} hasTranslation={true} translationPath="/en/">
  <a id="top"></a>

  <Hero lang={lang} />

  <!-- ── Manifesto / 01 ── -->
  <section class="relative py-32 md:py-40 divider-scan-top">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <div class="grid lg:grid-cols-12 gap-10">
        <div class="lg:col-span-3 reveal">
          <p class="font-mono text-[11px] text-signal-yellow tracking-[0.22em] uppercase">{t('home.manifesto.kicker')}</p>
          <p class="mt-3 font-mono text-[10px] text-bone-mute tracking-wider">— 宣言书</p>
        </div>
        <div class="lg:col-span-9 reveal">
          <p class="font-display text-[clamp(2.4rem,5.5vw,5rem)] leading-[1.05] text-bone tracking-tightest">
            {t('home.manifesto.title').replace('。','')}<span class="text-signal-yellow">。</span>
          </p>
          <p class="mt-10 max-w-2xl text-bone-dim text-lg leading-relaxed">
            {t('home.manifesto.body')}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Marquee strip — language pairs -->
  <section class="border-b border-bone/[0.08] py-6 overflow-hidden divider-scan-top" style="--scan-delay: -4s">
    <div class="marquee-track">
      {[...langPairs, ...langPairs].map((p, i) => (
        <div class="flex items-center gap-8 px-6 whitespace-nowrap">
          <span class="font-display text-3xl text-bone-dim">{p}</span>
          <span class="text-signal-yellow text-3xl">✦</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ── Focus / 02 ── -->
  <section class="relative py-32 md:py-40">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <SectionHeader num="02" kicker={t('home.focus.kicker').split('/')[0].trim()} title={t('home.focus.title').replace('。','')} serifAccent="" />

      <div class="mt-20 grid md:grid-cols-3 gap-px bg-bone/[0.08] border border-bone/[0.08] reveal-up-stagger">
        {focusItems.map((item) => (
          <article class="group relative bg-ink p-8 md:p-10 hover:bg-ink-800 transition-colors duration-500 cursor-pointer">
            <a href={item.href} class="block">
              <div class="flex items-start justify-between mb-12">
                <span class="font-mono text-[11px] text-bone-mute tracking-[0.2em]">{item.num} / {item.label}</span>
                <svg class="w-4 h-4 text-bone-mute group-hover:text-signal-yellow transition-all group-hover:-translate-y-1 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H8M17 7v9"/>
                </svg>
              </div>
              <h3 class="font-display text-3xl md:text-4xl text-bone leading-tight mb-6 group-hover:text-signal-yellow transition-colors">
                {item.title}
              </h3>
              <p class="text-bone-dim text-sm leading-relaxed mb-8">{item.desc}</p>
              <span class="inline-flex items-center gap-2 text-bone text-sm border-b border-bone/30 pb-1 group-hover:border-signal-yellow group-hover:text-signal-yellow transition-colors">
                {item.cta}
                <span>→</span>
              </span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CTA / 03 ── -->
  <section class="relative py-32 md:py-40 divider-scan-top" style="--scan-delay: -8s">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <div class="grid lg:grid-cols-12 gap-10 items-end">
        <div class="lg:col-span-8 reveal">
          <p class="font-mono text-[11px] text-signal-yellow tracking-[0.22em] uppercase mb-6">{t('home.cta.kicker')}</p>
          <h2 class="font-display text-mega text-bone leading-[0.95]">
            {t('home.cta.title')}<br/>
            <span class="font-display-italic text-signal-yellow">{t('home.cta.title_2')}</span>
          </h2>
        </div>
        <div class="lg:col-span-4 reveal">
          <p class="text-bone-dim leading-relaxed mb-8">{t('home.cta.body')}</p>
          <span class="magnetic">
            <a href={`/${lang}/contribute`} class="btn-primary">
              {t('home.cta.button')}
              <span>→</span>
            </a>
          </span>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
