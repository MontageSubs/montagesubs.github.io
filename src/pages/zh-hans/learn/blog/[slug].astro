---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) =>
    data.lang === 'zh-hans' && !data.draft
  );
  return posts.map((post) => ({
    params: { slug: post.slug.replace('zh-hans/', '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const dateStr = post.data.date.toISOString().slice(0, 10);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description ?? ''}
  lang="zh-hans"
  hasTranslation={post.data.has_translation}
  translationPath={post.data.has_translation ? `/en/learn/blog/${post.slug.replace('zh-hans/', '')}/` : undefined}
>
  <article class="max-w-3xl mx-auto px-5 sm:px-8 py-24">

    <a href="/zh-hans/learn" class="inline-flex items-center gap-2 font-mono text-[11px] text-bone-mute hover:text-signal-yellow uppercase tracking-[0.18em] mb-12 transition-colors">
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      返回学习
    </a>

    <header class="mb-16">
      <div class="flex flex-wrap items-center gap-3 mb-6 font-mono text-[11px] text-bone-mute tracking-[0.12em]">
        <time>{dateStr}</time>
        <span>·</span>
        <span>{post.data.author}</span>
        {post.data.has_translation && (
          <>
            <span>·</span>
            <a href={`/en/learn/blog/${post.slug.replace('zh-hans/', '')}/`} class="text-signal-yellow hover:underline">English version ↗</a>
          </>
        )}
      </div>
      <h1 class="font-display text-[clamp(2.4rem,5vw,4.5rem)] text-bone leading-[1.05] tracking-tightest mb-6">
        {post.data.title}
      </h1>
      {post.data.description && (
        <p class="text-bone-dim text-lg leading-relaxed">{post.data.description}</p>
      )}
      {post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 mt-8">
          {post.data.tags.map((tag: string) => (
            <span class="font-mono text-[11px] text-bone-mute border border-bone/10 px-2 py-0.5">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <div class="prose prose-invert prose-lg max-w-none
      prose-headings:font-display prose-headings:font-normal prose-headings:text-bone
      prose-p:text-bone-dim prose-p:leading-relaxed
      prose-a:text-signal-yellow prose-a:no-underline hover:prose-a:underline
      prose-strong:text-bone
      prose-code:text-signal-yellow prose-code:bg-ink-700 prose-code:px-1 prose-code:py-0.5 prose-code:rounded prose-code:font-mono
      prose-blockquote:border-signal-yellow/30 prose-blockquote:text-bone-dim
      prose-li:text-bone-dim
      prose-hr:border-bone/10
      " data-pagefind-body>
      <Content />
    </div>

    <footer class="mt-20 pt-8 border-t border-bone/[0.08] flex items-center justify-between">
      <a href="/zh-hans/learn" class="font-mono text-[11px] text-bone-mute hover:text-signal-yellow uppercase tracking-[0.18em] transition-colors">← 返回学习</a>
      <p class="font-mono text-[10px] text-bone-mute">CC BY-SA 4.0</p>
    </footer>
  </article>
</BaseLayout>
