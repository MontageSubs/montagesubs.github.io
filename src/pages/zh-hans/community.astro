---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui } from '../../i18n';
import { members } from '../../data/community';

const lang = 'zh-hans';
const t = (k: keyof typeof ui['zh-hans']) => ui['zh-hans'][k];

const conduct = [
  { key: 'respect',      ok: true },
  { key: 'constructive', ok: true },
  { key: 'open',         ok: true },
  { key: 'zero',         ok: false },
] as const;
---

<BaseLayout title="社区" description="蒙太奇字幕社区的核心成员、讨论区与行为准则。" lang={lang}>

  <section class="relative pt-24 md:pt-32 pb-16 border-b border-bone/[0.08]">
    <div class="absolute inset-0 bg-grid opacity-50 pointer-events-none"></div>
    <div class="relative max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <div class="grid lg:grid-cols-12 gap-10">
        <h1 class="lg:col-span-7 font-display text-display text-bone leading-[0.92] tracking-tightest reveal">
          社<span class="font-display-italic text-signal-yellow">区</span>
        </h1>
        <p class="lg:col-span-5 self-end text-bone-dim text-lg leading-relaxed reveal">{t('community.lead')}</p>
      </div>
    </div>
  </section>

  <!-- Members -->
  <section class="py-24 border-b border-bone/[0.08]">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <h2 class="font-display text-mega text-bone leading-[0.95] mb-12 reveal">{t('community.members.title')}</h2>
      <div class="grid md:grid-cols-2 gap-px bg-bone/[0.08] border border-bone/[0.08] reveal-up-stagger">
        {members.map((m) => (
          <article class="bg-ink p-8 md:p-10">
            <div class="flex items-start gap-5 mb-6">
              <div class="w-16 h-16 border border-signal-yellow/40 flex items-center justify-center bg-ink-800">
                <span class="font-display-italic text-4xl text-signal-yellow leading-none">{m.initial}</span>
              </div>
              <div>
                <h3 class="font-display text-3xl text-bone">{m.name}</h3>
                <p class="font-mono text-[11px] text-bone-mute uppercase tracking-[0.15em] mt-1">{m.role_zh}</p>
              </div>
            </div>
            <p class="text-bone-dim text-sm leading-relaxed mb-6">{m.bio_zh}</p>
            <div class="flex items-center justify-between pt-5 border-t border-bone/[0.07]">
              <span class="font-mono text-[11px] text-bone-mute">加入于 {m.joined}</span>
              {m.github && <a href={m.github} target="_blank" rel="noopener noreferrer" class="text-signal-yellow text-sm hover:underline">GitHub ↗</a>}
            </div>
          </article>
        ))}
        <article class="bg-ink p-8 md:p-10 flex flex-col items-center justify-center text-center border border-dashed border-bone/15 m-px">
          <span class="font-display text-5xl text-signal-yellow mb-4">+</span>
          <h3 class="font-display text-2xl text-bone mb-2">{t('community.members.empty.title')}</h3>
          <p class="text-bone-mute text-sm mb-5 max-w-xs">{t('community.members.empty.body')}</p>
          <a href={`/${lang}/contribute`} class="text-signal-yellow text-sm hover:underline">{t('community.members.empty.cta')} →</a>
        </article>
      </div>
    </div>
  </section>

  <!-- Discussions -->
  <section class="py-24 border-b border-bone/[0.08]">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <h2 class="font-display text-mega text-bone leading-[0.95] mb-12 reveal">{t('community.discussions.title')}</h2>
      <div class="border border-bone/[0.08] p-8 md:p-12 flex flex-col md:flex-row md:items-center justify-between gap-6 reveal">
        <div class="max-w-2xl">
          <p class="font-mono text-[11px] text-bone-mute uppercase tracking-[0.2em] mb-3">— GitHub Discussions</p>
          <p class="text-bone-dim leading-relaxed">{t('community.discussions.body')}</p>
        </div>
        <a href="https://github.com/MontageSubs/community/discussions" target="_blank" rel="noopener noreferrer" class="btn-ghost shrink-0">
          {t('community.discussions.cta')} ↗
        </a>
      </div>
    </div>
  </section>

  <!-- Conduct -->
  <section id="conduct" class="py-24">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <h2 class="font-display text-mega text-bone leading-[0.95] mb-6 reveal">{t('community.conduct.title')}</h2>
      <p class="max-w-2xl text-bone-dim leading-relaxed mb-12 reveal">{t('community.conduct.body')}</p>
      <div class="grid md:grid-cols-2 gap-px bg-bone/[0.08] border border-bone/[0.08] reveal-up-stagger">
        {conduct.map((c, i) => (
          <div class="bg-ink p-8">
            <div class="flex items-start gap-4">
              <span class={`mt-1 font-mono text-lg ${c.ok ? 'text-live' : 'text-signal-yellow'}`}>{c.ok ? '✓' : '✗'}</span>
              <div>
                <h3 class="font-display text-2xl text-bone mb-2">{t(`community.conduct.${c.key}.title` as any)}</h3>
                <p class="text-bone-dim text-sm leading-relaxed">{t(`community.conduct.${c.key}.body` as any)}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
      <p class="mt-8 text-bone-mute text-sm reveal">
        {t('community.conduct.report')} <a href="mailto:conduct@montagesubs.org" class="text-signal-yellow hover:underline">conduct@montagesubs.org</a>
      </p>
    </div>
  </section>
</BaseLayout>
