---
import BaseLayout from '../layouts/BaseLayout.astro';
import { renderNotFoundScript } from '../i18n/inlineScripts';
import { fallbackLang, htmlLangTags, supportedLangs } from '../i18n/locales';
import { useTranslations } from '../i18n';

const fallbackTitle = useTranslations(fallbackLang)('notfound.title');
---

<BaseLayout title={fallbackTitle} lang={fallbackLang} hasTranslation={false} chrome={false} noindex>
  <section class="relative min-h-screen flex flex-col items-center justify-center px-5 py-20 overflow-hidden">

    <div class="absolute inset-0 pointer-events-none opacity-[0.06]" aria-hidden="true"
      style="background: repeating-linear-gradient(0deg, transparent 0px, transparent 2px, rgba(245,241,232,1) 2px, rgba(245,241,232,1) 3px);">
    </div>

    <div class="relative grid grid-cols-7 w-full max-w-md h-32 md:h-40 mb-12 border border-bone/15" aria-hidden="true">
      <div style="background:#f5f1e8"></div>
      <div style="background:#FBC100"></div>
      <div style="background:#22c55e"></div>
      <div style="background:#06b6d4"></div>
      <div style="background:#a855f7"></div>
      <div style="background:#ef4444"></div>
      <div style="background:#0E0B07"></div>
    </div>

    {supportedLangs.map((code) => {
      const t = useTranslations(code);
      return (
        <div data-locale-block={code} data-title={`${t('notfound.title')} · MontageSubs`} lang={htmlLangTags[code]} hidden={code !== fallbackLang}>
          <div class="relative flex flex-col items-center text-center">
            <p class="font-mono text-[11px] text-signal-yellow uppercase tracking-[0.22em] mb-4 flex items-center gap-2">
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-signal-yellow animate-pulse"></span>
              {t('notfound.eyebrow')}
            </p>

            <h1 class="font-display text-[clamp(5rem,18vw,12rem)] text-bone leading-none tracking-tightest mb-8">
              4<span class="font-display-italic text-signal-yellow">0</span>4
            </h1>

            <p class="text-bone-dim mb-10">{t('notfound.message')}</p>

            <span class="magnetic">
              <a href={`/${code}/`} data-locale={code} class="btn-primary">
                {t('notfound.home')}
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/>
                </svg>
              </a>
            </span>

            <p class="mt-16 font-mono text-[10px] text-bone-mute/50 tracking-[0.24em] uppercase">{t('notfound.footer')}</p>
          </div>
        </div>
      );
    })}
  </section>

  <script is:inline set:html={renderNotFoundScript()} />
</BaseLayout>
