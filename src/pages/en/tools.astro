---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui } from '../../i18n';
import { tools } from '../../data/tools';
const lang = 'en';
const t = (k: keyof typeof ui['zh-hans']) => ui['en'][k];
const filters = [
  { label: t('tools.filter.all'),         value: 'all' },
  { label: t('tools.filter.online'),      value: 'type:online' },
  { label: t('tools.filter.installable'), value: 'type:installable' },
  { label: t('tools.filter.beta'),        value: 'status:beta' },
] as const;
---
<BaseLayout title="Toolkit" description="Open-source tools for subtitle work." lang={lang}>
  <section class="relative pt-24 md:pt-32 pb-16 border-b border-bone/[0.08]">
    <div class="absolute inset-0 bg-grid opacity-50 pointer-events-none"></div>
    <div class="relative max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <div class="grid lg:grid-cols-12 gap-10">
        <h1 class="lg:col-span-7 font-display text-display text-bone leading-[0.92] tracking-tightest reveal"><span class="font-display-italic text-signal-yellow">Tool</span>kit</h1>
        <p class="lg:col-span-5 self-end text-bone-dim text-lg leading-relaxed reveal">{t('tools.lead')}</p>
      </div>
    </div>
  </section>
  <section class="py-6 sticky top-16 z-30 bg-ink/95 backdrop-blur">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12 flex items-center justify-between gap-6 flex-wrap">
      <div class="flex flex-wrap gap-1">
        {filters.map(({ label, value }, i) => (
          <button type="button" data-tool-filter={value} data-active={i===0?'true':'false'}
            class="px-4 py-2 text-[13px] font-mono uppercase tracking-[0.1em] border border-bone/10 transition-all data-[active=true]:bg-signal-yellow data-[active=true]:text-ink data-[active=true]:border-signal-yellow text-bone-dim hover:text-bone hover:border-bone/40">{label}</button>
        ))}
      </div>
      <span class="font-mono text-[11px] text-bone-mute tracking-[0.18em]">{tools.length} TOOLS</span>
    </div>
  </section>
  <section class="py-20">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-bone/[0.08] border border-bone/[0.08]" data-tool-grid>
        {tools.map((tool, i) => (
          <article data-tool-card data-type={tool.type} data-status={tool.status} class="group bg-ink p-8 hover:bg-ink-800 transition-colors flex flex-col">
            <div class="flex items-start justify-between mb-8">
              <div class="w-14 h-14 border border-signal-yellow/40 flex items-center justify-center group-hover:bg-signal-yellow/10 transition-colors">
                <span class="font-display-italic text-3xl text-signal-yellow leading-none">{tool.name.charAt(0)}</span>
              </div>
            </div>
            <div class="flex flex-wrap gap-1.5 mb-4">
              <span class="font-mono text-[10px] uppercase tracking-[0.1em] px-2 py-0.5 border border-bone/15 text-bone-dim">{tool.type==='online'?t('common.type.online'):t('common.type.installable')}</span>
              <span class="font-mono text-[10px] uppercase tracking-[0.1em] px-2 py-0.5 border border-bone/15 text-bone-dim">{tool.status==='active'?t('common.status.active'):tool.status==='beta'?t('common.status.beta'):t('common.status.archived')}</span>
            </div>
            <h2 class="font-display text-3xl text-bone group-hover:text-signal-yellow transition-colors mb-3">{tool.name}</h2>
            <p class="text-bone-dim text-sm leading-relaxed flex-1 mb-6">{tool.description_en}</p>
            <div class="flex items-center justify-between pt-5 border-t border-bone/[0.07]">
              <span class="font-mono text-[11px] text-bone-mute">by {tool.author}</span>
              {tool.url && <a href={tool.url} target="_blank" rel="noopener noreferrer" class="text-signal-yellow text-sm hover:underline">{tool.type==='online'?'Open ↗':'Details ↗'}</a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
