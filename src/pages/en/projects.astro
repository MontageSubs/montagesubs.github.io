---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui } from '../../i18n';
import { projects } from '../../data/projects';
const lang = 'en';
const t = (k: keyof typeof ui['zh-hans']) => ui['en'][k];
const filters = [
  { label: t('projects.filter.all'),       value: 'all' },
  { label: t('projects.filter.active'),    value: 'active' },
  { label: t('projects.filter.completed'), value: 'completed' },
  { label: t('projects.filter.hiatus'),    value: 'hiatus' },
] as const;
const statusLabel = { active: t('common.status.active'), completed: t('common.status.completed'), hiatus: t('common.status.hiatus') };
---
<BaseLayout title="Projects" description="Active and completed subtitle projects." lang={lang}>
  <section class="relative pt-24 md:pt-32 pb-16 border-b border-bone/[0.08]">
    <div class="absolute inset-0 bg-grid opacity-50 pointer-events-none"></div>
    <div class="relative max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <div class="grid lg:grid-cols-12 gap-10">
        <h1 class="lg:col-span-7 font-display text-display text-bone leading-[0.92] tracking-tightest reveal">Subtitle <span class="font-display-italic text-signal-yellow">projects</span></h1>
        <p class="lg:col-span-5 self-end text-bone-dim text-lg leading-relaxed reveal">{t('projects.lead')}</p>
      </div>
    </div>
  </section>
  <section class="py-12 border-b border-bone/[0.08] sticky top-16 z-30 bg-ink/95 backdrop-blur">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12 flex items-center justify-between gap-6 flex-wrap">
      <div class="flex flex-wrap gap-1">
        {filters.map(({ label, value }, i) => (
          <button type="button" data-project-filter={value} data-active={i===0?'true':'false'}
            class="px-4 py-2 text-[13px] font-mono uppercase tracking-[0.1em] border border-bone/10 transition-all data-[active=true]:bg-signal-yellow data-[active=true]:text-ink data-[active=true]:border-signal-yellow text-bone-dim hover:text-bone hover:border-bone/40">{label}</button>
        ))}
      </div>
      <span class="font-mono text-[11px] text-bone-mute tracking-[0.18em]">{projects.length} ITEMS</span>
    </div>
  </section>
  <section class="py-20">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <ol class="grid gap-px bg-bone/[0.08] border border-bone/[0.08]">
        {projects.map((p, i) => (
          <li data-project-card data-status={p.status} class="spotlight-card bg-ink hover:bg-ink-800 transition-colors group">
            <a href={`/${lang}/projects/${p.id}`} class="grid md:grid-cols-12 gap-6 p-6 md:p-10 items-start">
              <div class="md:col-span-1"><span class="font-mono text-[11px] text-bone-mute tracking-[0.18em]">N° {String(i+1).padStart(2,'0')}</span></div>
              <div class="md:col-span-2 flex items-center gap-2">
                <span class={`inline-block w-1.5 h-1.5 rounded-full ${p.status==='active'?'bg-live animate-pulse':p.status==='completed'?'bg-signal-yellow':'bg-bone-mute'}`}></span>
                <span class="font-mono text-[11px] text-bone-dim uppercase tracking-[0.1em]">{statusLabel[p.status]}</span>
              </div>
              <div class="md:col-span-5">
                <h2 class="font-display text-3xl md:text-4xl text-bone group-hover:text-signal-yellow transition-colors leading-tight">{p.title_en}</h2>
                <p class="mt-3 text-bone-dim text-sm leading-relaxed max-w-xl">{p.description_en}</p>
                <div class="mt-4 flex flex-wrap gap-1.5">
                  {p.tags_en.map(tag => (<span class="font-mono text-[11px] text-bone-mute border border-bone/10 px-2 py-0.5">{tag}</span>))}
                </div>
              </div>
              <div class="md:col-span-2 md:text-right"><span class="font-display text-3xl text-bone-mute group-hover:text-signal-yellow transition-colors">{p.year}</span></div>
              <div class="md:col-span-2 md:text-right self-center"><span class="text-bone text-sm group-hover:text-signal-yellow transition-colors">Details →</span></div>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>
