---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui } from '../../i18n';
import { getCollection } from 'astro:content';
const lang = 'en';
const t = (k: keyof typeof ui['zh-hans']) => ui['en'][k];

const posts = (await getCollection('blog', ({ data }) =>
  data.lang === 'en' && !data.draft
)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const standards = [
  { key: 'formats',  status: 'published' },
  { key: 'quality',  status: 'published' },
  { key: 'timing',   status: 'draft' },
  { key: 'layout',   status: 'planned' },
] as const;
const statusMap = { published: t('learn.status.published'), draft: t('learn.status.draft'), planned: t('learn.status.planned') };
---
<BaseLayout title="Learn" description="Notes, tutorials and standards from the community." lang={lang}>
  <section class="relative pt-24 md:pt-32 pb-16 border-b border-bone/[0.08]">
    <div class="absolute inset-0 bg-grid opacity-50 pointer-events-none"></div>
    <div class="relative max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <p class="font-mono text-[11px] text-signal-yellow tracking-[0.22em] uppercase mb-6 reveal">{t('learn.kicker')}</p>
      <div class="grid lg:grid-cols-12 gap-10">
        <h1 class="lg:col-span-7 font-display text-display text-bone leading-[0.92] tracking-tightest reveal">Learning <span class="font-display-italic text-signal-yellow">resources</span></h1>
        <p class="lg:col-span-5 self-end text-bone-dim text-lg leading-relaxed reveal">{t('learn.lead')}</p>
      </div>
    </div>
  </section>
  <section id="blog" class="py-24 border-b border-bone/[0.08]">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <div class="flex items-end justify-between mb-12 reveal">
        <h2 class="font-display text-mega text-bone leading-[0.95]">{t('learn.blog.title')}</h2>
        <a href={`/${lang}/rss.xml`} class="font-mono text-[12px] text-bone-dim hover:text-signal-yellow transition-colors">↻ {t('learn.blog.rss')}</a>
      </div>
      {posts.length === 0 ? (
        <div class="p-12 border border-bone/[0.08] text-center reveal">
          <p class="text-bone-mute">Articles coming soon.</p>
        </div>
      ) : (
        <ol class="grid gap-px bg-bone/[0.08] border border-bone/[0.08]">
          {posts.map((post, i) => {
            const slug = post.slug.replace('en/', '');
            const dateStr = post.data.date.toISOString().slice(0, 10);
            return (
              <li class="bg-ink hover:bg-ink-800 transition-colors group">
                <a href={`/${lang}/learn/blog/${slug}/`} class="grid md:grid-cols-12 gap-6 p-6 md:p-8 items-center">
                  <div class="md:col-span-1 font-mono text-[11px] text-bone-mute">N° {String(i+1).padStart(2,'0')}</div>
                  <div class="md:col-span-2 font-mono text-[11px] text-bone-dim">{dateStr}</div>
                  <div class="md:col-span-2 font-mono text-[11px] text-bone-mute">{post.data.author}</div>
                  <h3 class="md:col-span-5 font-display text-2xl text-bone group-hover:text-signal-yellow transition-colors">{post.data.title}</h3>
                  <div class="md:col-span-2 md:text-right">
                    {post.data.tags.map((tag: string) => (<span class="inline-block font-mono text-[10px] text-bone-mute border border-bone/10 px-2 py-0.5 ml-1">{tag}</span>))}
                  </div>
                </a>
              </li>
            );
          })}
        </ol>
      )}
    </div>
  </section>
  <section id="tutorials" class="py-24 border-b border-bone/[0.08]">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <h2 class="font-display text-mega text-bone leading-[0.95] mb-12 reveal">{t('learn.tutorials.title')}</h2>
      <div class="p-12 md:p-20 border border-bone/[0.08] text-center reveal">
        <p class="font-display text-3xl text-bone mb-4">{t('learn.tutorials.empty.title')} <span class="caret"></span></p>
        <p class="text-bone-dim max-w-xl mx-auto">{t('learn.tutorials.empty.body')}</p>
      </div>
    </div>
  </section>
  <section id="standards" class="py-24">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <h2 class="font-display text-mega text-bone leading-[0.95] mb-12 reveal">{t('learn.standards.title')}</h2>
      <div class="grid md:grid-cols-2 gap-px bg-bone/[0.08] border border-bone/[0.08] reveal-up-stagger">
        {standards.map((s, i) => (
          <a href={`/${lang}/learn/standards/${s.key}`} class="group bg-ink p-8 hover:bg-ink-800 transition-colors">
            <div class="flex items-center justify-between mb-6">
              <span class="font-mono text-[11px] text-bone-mute tracking-[0.2em]">0{i+1} / SPEC</span>
              <span class="font-mono text-[10px] uppercase tracking-[0.15em] px-2 py-0.5 border border-bone/15 text-bone-dim">{statusMap[s.status]}</span>
            </div>
            <h3 class="font-display text-3xl text-bone group-hover:text-signal-yellow transition-colors mb-3">{t(`learn.standards.${s.key}.title` as any)}</h3>
            <p class="text-bone-dim text-sm leading-relaxed">{t(`learn.standards.${s.key}.body` as any)}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
