---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ui } from '../../i18n';
import { members } from '../../data/community';
const lang = 'en';
const t = (k: keyof typeof ui['zh-hans']) => ui['en'][k];
const conduct = [
  { key: 'respect', ok: true }, { key: 'constructive', ok: true },
  { key: 'open', ok: true }, { key: 'zero', ok: false },
] as const;
---
<BaseLayout title="Community" description="Members, discussions and code of conduct." lang={lang}>
  <section class="relative pt-24 md:pt-32 pb-16 border-b border-bone/[0.08]">
    <div class="absolute inset-0 bg-grid opacity-50 pointer-events-none"></div>
    <div class="relative max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <p class="font-mono text-[11px] text-signal-yellow tracking-[0.22em] uppercase mb-6 reveal">{t('community.kicker')}</p>
      <div class="grid lg:grid-cols-12 gap-10">
        <h1 class="lg:col-span-7 font-display text-display text-bone leading-[0.92] tracking-tightest reveal"><span class="font-display-italic text-signal-yellow">Comm</span>unity</h1>
        <p class="lg:col-span-5 self-end text-bone-dim text-lg leading-relaxed reveal">{t('community.lead')}</p>
      </div>
    </div>
  </section>
  <section class="py-24 border-b border-bone/[0.08]">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <h2 class="font-display text-mega text-bone leading-[0.95] mb-12 reveal">{t('community.members.title')}</h2>
      <div class="grid md:grid-cols-2 gap-px bg-bone/[0.08] border border-bone/[0.08] reveal-up-stagger">
        {members.map((m) => (
          <article class="bg-ink p-8 md:p-10">
            <div class="flex items-start gap-5 mb-6">
              <div class="w-16 h-16 border border-signal-yellow/40 flex items-center justify-center bg-ink-800">
                <span class="font-display-italic text-4xl text-signal-yellow leading-none">{m.initial}</span>
              </div>
              <div>
                <h3 class="font-display text-3xl text-bone">{m.name}</h3>
                <p class="font-mono text-[11px] text-bone-mute uppercase tracking-[0.15em] mt-1">{m.role_en}</p>
              </div>
            </div>
            <p class="text-bone-dim text-sm leading-relaxed mb-6">{m.bio_en}</p>
            <div class="flex items-center justify-between pt-5 border-t border-bone/[0.07]">
              <span class="font-mono text-[11px] text-bone-mute">Joined {m.joined}</span>
              {m.github && <a href={m.github} target="_blank" rel="noopener noreferrer" class="text-signal-yellow text-sm hover:underline">GitHub ↗</a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section id="conduct" class="py-24">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
      <h2 class="font-display text-mega text-bone leading-[0.95] mb-6 reveal">{t('community.conduct.title')}</h2>
      <p class="max-w-2xl text-bone-dim leading-relaxed mb-12 reveal">{t('community.conduct.body')}</p>
      <div class="grid md:grid-cols-2 gap-px bg-bone/[0.08] border border-bone/[0.08] reveal-up-stagger">
        {conduct.map(c => (
          <div class="bg-ink p-8">
            <div class="flex items-start gap-4">
              <span class={`mt-1 font-mono text-lg ${c.ok ? 'text-live' : 'text-signal-yellow'}`}>{c.ok ? '✓' : '✗'}</span>
              <div>
                <h3 class="font-display text-2xl text-bone mb-2">{t(`community.conduct.${c.key}.title` as any)}</h3>
                <p class="text-bone-dim text-sm leading-relaxed">{t(`community.conduct.${c.key}.body` as any)}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
