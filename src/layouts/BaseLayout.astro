---
import '../styles/global.css';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import IconLinks from '../components/IconLinks.astro';
import LocalePreference from '../components/LocalePreference.astro';
import MotionScripts from '../components/MotionScripts.astro';
import SocialMeta from '../components/SocialMeta.astro';
import { isUnindexedPath } from '../config/indexing';
import { defaultLang, htmlLangTags, type Lang } from '../i18n/locales';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  hasTranslation?: boolean;
  translationPath?: string;
  ogImage?: string;
  chrome?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = 'MontageSubs is a nonprofit, open-source subtitle community.',
  lang = 'zh-hans',
  hasTranslation = true,
  translationPath,
  ogImage,
  chrome = true,
  noindex = false,
} = Astro.props;

const siteURL = Astro.site ?? new URL('https://subs.js.org');
const currentURL = Astro.url.href;
const htmlLang = htmlLangTags[lang as Lang];
const alternateLang = lang === 'zh-hans' ? 'en' : 'zh-hans';
const alternatePath = translationPath
  ? new URL(translationPath, siteURL).href
  : currentURL.replace(`/${lang}/`, `/${alternateLang}/`);
const isHome = Astro.url.pathname === `/${lang}/`;
const defaultLanguageURL =
  lang === defaultLang || !hasTranslation ? currentURL : alternatePath;
const defaultEntryURL = isHome ? siteURL.href : defaultLanguageURL;
const excludedFromIndex = noindex || isUnindexedPath(Astro.url.pathname);
---

<!DOCTYPE html>
<html lang={htmlLang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} · MontageSubs</title>
    <meta name="description" content={description} />
    {excludedFromIndex && <meta name="robots" content="noindex" />}

    <link rel="canonical" href={currentURL} />
    <link rel="alternate" hreflang={htmlLang} href={currentURL} />
    {hasTranslation && (
      <link rel="alternate" hreflang={lang === 'zh-hans' ? 'en' : 'zh-Hans'} href={alternatePath} />
    )}
    <link rel="alternate" hreflang="x-default" href={defaultEntryURL} />

    <SocialMeta title={`${title} · MontageSubs`} description={description} url={currentURL} image={ogImage} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`MontageSubs ${lang === 'zh-hans' ? '博客' : 'Blog'}`}
      href={`/${lang}/rss.xml`}
    />

    <IconLinks />
    <slot name="head" />
  </head>

  <body class="bg-ink text-bone min-h-screen flex flex-col antialiased">
    {chrome && <AnnouncementBar lang={lang} />}
    {chrome && <Header lang={lang} hasTranslation={hasTranslation} translationPath={translationPath} />}

    <main class="flex-1 relative">
      <slot />
    </main>

    {chrome && <Footer lang={lang} />}

    <MotionScripts />
    <LocalePreference />
  </body>
</html>
