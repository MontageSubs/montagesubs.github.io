---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MotionScripts from '../components/MotionScripts.astro';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  hasTranslation?: boolean;
  translationPath?: string;
  ogImage?: string;
}

const {
  title,
  description = '蒙太奇字幕社区 — 连接观众、译者、开发者与影视工作者，共同构建开放、透明的字幕生态。',
  lang = 'zh-hans',
  hasTranslation = true,
  translationPath,
  ogImage,
} = Astro.props;

const siteURL = Astro.site ?? new URL('https://montagesubs.github.io');
const currentURL = Astro.url.href;
const htmlLang = lang === 'zh-hans' ? 'zh-Hans' : 'en';
const alternateLang = lang === 'zh-hans' ? 'en' : 'zh-hans';
const alternatePath = translationPath
  ? new URL(translationPath, siteURL).href
  : currentURL.replace(`/${lang}/`, `/${alternateLang}/`);
---

<!DOCTYPE html>
<html lang={htmlLang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} · MontageSubs</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={currentURL} />
    <link rel="alternate" hreflang={htmlLang} href={currentURL} />
    {hasTranslation && (
      <link rel="alternate" hreflang={lang === 'zh-hans' ? 'en' : 'zh-Hans'} href={alternatePath} />
    )}
    <link rel="alternate" hreflang="x-default" href={new URL('/zh-hans/', siteURL).href} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentURL} />
    <meta property="og:title" content={`${title} · MontageSubs`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="MontageSubs" />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · MontageSubs`} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`MontageSubs ${lang === 'zh-hans' ? '博客' : 'Blog'}`}
      href={`/${lang}/rss.xml`}
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="bg-ink text-bone min-h-screen flex flex-col antialiased">
    <Header lang={lang} hasTranslation={hasTranslation} translationPath={translationPath} />

    <main class="flex-1 relative">
      <slot />
    </main>

    <Footer lang={lang} />

    <MotionScripts />
  </body>
</html>
