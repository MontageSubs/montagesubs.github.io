---
import { ui, type Lang } from '../i18n';

interface Props {
  lang: string;
  hasTranslation?: boolean;
  translationPath?: string;
}

const { lang, hasTranslation = true, translationPath } = Astro.props;
const l = lang as Lang;
const isZh = lang === 'zh-hans';

// 根据当前语言读取导航与公共文案，缺失时回退到中文。
function t(key: keyof typeof ui['zh-hans']): string {
  return ((ui[l] as typeof ui['zh-hans'])[key] ?? ui['zh-hans'][key]) as string;
}

const navItems: { key: keyof typeof ui['zh-hans']; href: string }[] = [
  { key: 'nav.about',      href: `/${lang}/about` },
  { key: 'nav.projects',   href: `/${lang}/projects` },
  { key: 'nav.tools',      href: `/${lang}/tools` },
  { key: 'nav.learn',      href: `/${lang}/learn` },
  { key: 'nav.community',  href: `/${lang}/community` },
  { key: 'nav.contribute', href: `/${lang}/contribute` },
];

const currentPath = Astro.url.pathname;
const alternateLang = lang === 'zh-hans' ? 'en' : 'zh-hans';
const alternatePath = translationPath
  ? translationPath
  : currentPath.replace(`/${lang}/`, `/${alternateLang}/`);
---

<header class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-ink/80 border-b border-bone/[0.06]" data-pagefind-ignore>
  <nav class="max-w-[1400px] mx-auto px-5 sm:px-8 lg:px-12">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href={`/${lang}/`} class="flex items-center gap-3 shrink-0 group" aria-label="MontageSubs">
        <img src="/brand/m-mark-header.svg" alt="" width="36" height="36"
             class="w-9 h-9 rounded-md transition-transform group-hover:scale-105"
             aria-hidden="true" />
        <div class="hidden sm:flex flex-col leading-tight">
          <span class="text-bone text-[13px] font-medium tracking-wide">
            {isZh ? '蒙太奇字幕社区' : 'MontageSubs'}
          </span>
          <span class="font-mono text-[10px] text-bone-mute uppercase tracking-[0.2em]">
            {isZh ? 'Subtitle Studio' : 'subtitle studio · 字幕社区'}
          </span>
        </div>
      </a>

      <!-- Desktop nav -->
      <div class="hidden lg:flex items-center gap-0.5">
        {navItems.map(({ key, href }) => {
          const active = currentPath.startsWith(href);
          return (
            <a href={href} class={`relative group px-3 py-2 text-[13px] transition-colors ${active ? 'text-signal-yellow' : 'text-bone-dim hover:text-bone'}`}>
              <span>{t(key)}</span>
              {active && <span class="absolute -bottom-px left-3 right-3 h-px bg-signal-yellow"></span>}
            </a>
          );
        })}
      </div>

      <!-- Right -->
      <div class="flex items-center gap-1 sm:gap-2">

        <!-- Search -->
        <a href={`/${lang}/search`} class="p-2 text-bone-dim hover:text-bone transition-colors" aria-label={t('nav.search')}>
          <svg class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </a>

        <!-- Lang switch -->
        <div class="relative group">
          <button class="flex items-center gap-1.5 px-3 py-2 text-[12px] text-bone-dim hover:text-bone transition-colors font-mono uppercase tracking-[0.15em]" aria-haspopup="true">
            {isZh ? 'ZH' : 'EN'}
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute right-0 top-full pt-1 invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all">
            <div class="w-44 py-1 bg-ink-700 border border-bone/10">
              <a href={isZh ? '#' : alternatePath.replace('/en/', '/zh-hans/')}
                class={`flex items-center justify-between px-4 py-2.5 text-sm transition-colors ${isZh ? 'text-signal-yellow cursor-default' : 'text-bone-dim hover:bg-bone/5'}`}>
                <span>简体中文</span>
                {isZh && <span class="font-mono text-[10px]">▸</span>}
              </a>
              {!isZh ? (
                <a href="#" class="flex items-center justify-between px-4 py-2.5 text-sm text-signal-yellow cursor-default">
                  <span>English</span>
                  <span class="font-mono text-[10px]">▸</span>
                </a>
              ) : hasTranslation ? (
                <a href={alternatePath} class="flex items-center justify-between px-4 py-2.5 text-sm text-bone-dim hover:bg-bone/5 transition-colors">
                  <span>English</span>
                </a>
              ) : (
                <span class="flex items-center justify-between px-4 py-2.5 text-sm text-bone-mute cursor-not-allowed">
                  <span>English</span>
                  <span class="text-[10px]">N/A</span>
                </span>
              )}
            </div>
          </div>
        </div>

        <!-- CTA -->
        <a href="https://t.me/MontageSubs"
           class="hidden sm:inline-flex items-center gap-1.5 bg-signal-yellow text-ink text-[12px] font-semibold px-4 py-2 rounded-full hover:bg-yellow-300 transition-colors"
           target="_blank" rel="noopener noreferrer">
          {t('nav.join')}
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>

        <!-- Mobile -->
        <button id="mobile-menu-btn" class="lg:hidden p-2 text-bone-dim hover:text-bone transition-colors" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden lg:hidden border-t border-bone/[0.07] py-4">
      <div class="flex flex-col">
        {navItems.map(({ key, href }) => {
          const active = currentPath.startsWith(href);
          return (
            <a href={href} class={`py-3 text-base transition-colors ${active ? 'text-signal-yellow' : 'text-bone-dim hover:text-bone'}`}>
              <span>{t(key)}</span>
            </a>
          );
        })}
      </div>
      <a href="https://t.me/MontageSubs" target="_blank" rel="noopener noreferrer"
         class="mt-4 flex items-center justify-center gap-2 bg-signal-yellow text-ink text-sm font-semibold py-3 rounded-full">
        {t('nav.join')}
      </a>
    </div>
  </nav>
</header>

<!-- Spacer -->
<div class="h-16"></div>
