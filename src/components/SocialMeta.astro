---
interface Props {
  title: string;
  description: string;
  url: string;
  image?: string;
}

const { title, description, url, image } = Astro.props;
const siteURL = Astro.site ?? new URL('https://subs.js.org');
const hasDefaultImage = !image;
const imageURL = image ?? new URL('/og-default.png', siteURL).href;
---

<meta property="og:type" content="website" />
<meta property="og:url" content={url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="MontageSubs" />
<meta property="og:image" content={imageURL} />
{hasDefaultImage && <meta property="og:image:width" content="1200" />}
{hasDefaultImage && <meta property="og:image:height" content="630" />}
{hasDefaultImage && <meta property="og:image:alt" content="MontageSubs" />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
{hasDefaultImage && <meta name="twitter:image:alt" content="MontageSubs" />}
